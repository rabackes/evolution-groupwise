# SPDX-License-Identifier: LGPL-2.1-or-later
pkgname=evolution-groupwise
pkgver=0.11.2
pkgrel=1
pkgdesc='GroupWise mail, contacts and calendars in Evolution'
arch=('x86_64')
url='https://github.com/rabackes/evolution-groupwise'
license=('LGPL-2.1-or-later')
depends=('evolution>=3.52' 'evolution-data-server>=3.52' 'glib2' 'glibc'
         'gdk-pixbuf2' 'gtk3' 'libgcc' 'libical' 'libsoup3' 'libxml2')
# Arch's evolution and evolution-data-server packages include development headers.
# Python is required at CMake configure time, even when checks are disabled.
makedepends=('cmake' 'gettext' 'pkgconf' 'python')
checkdepends=('openssl')
# Pin to the tagged release commit, rather than applying packaging patches.
_commit=47939651462aaca3ef860820062c34ac4e247a93
source=("$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('299eb8561e1493dce8ac5bf8a82ccfc7f5e5bb088a6755b175892f1784071fc3')

build() {
  cmake -S "$pkgname-$_commit" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DWITH_EVOLUTION_UI=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
